{
  "name": "prediabetes-pal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "typecheck": "rm -rf .next/dev/types .next/types && next typegen && test -f .next/types/routes.d.ts && tsc --noEmit",
    "build": "next build",
    "test": "vitest run",
    "e2e": "tsx scripts/run-playwright.ts",
    "lint": "eslint .",
    "contract": "node scripts/validate-safety-contract.mjs",
    "config:production-check": "tsx scripts/check-production-config.ts",
    "db:migrate:production": "PAL_DB_ENV=production drizzle-kit migrate",
    "db:governance:check": "node scripts/check-db-governance.mjs",
    "test:pal": "vitest run tests/unit/pal",
    "eval:pal": "vitest run tests/evals/pal-safety-eval.test.ts",
    "eval:pal:live": "node scripts/run-graded-evals.mjs",
    "eval:pantry-extract": "vitest run tests/evals/pantry-extract-eval.test.ts",
    "eval:meal-photo": "EVAL_MEAL_PHOTO_LIVE=1 vitest run tests/evals/meal-photo-eval.test.ts",
    "eval:model-bakeoff": "tsx scripts/model-bakeoff.ts --dry-run",
    "eval:model-bakeoff:mock": "tsx scripts/model-bakeoff.ts --mock",
    "eval:model-bakeoff:live": "tsx scripts/model-bakeoff.ts --live",
    "review:dietitian:validate": "node scripts/validate-dietitian-review.mjs",
    "review:dietitian:close": "node scripts/validate-dietitian-review.mjs --require-close",
    "video-engine": "tsx video-engine/run.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@remotion/bundler": "^4.0.487",
    "@remotion/renderer": "^4.0.487",
    "@sentry/browser": "^10.65.0",
    "@sentry/node": "10.65.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.5.0",
    "@vercel/edge-config": "^1.4.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "openai": "6.36.0",
    "pg": "^8.22.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remotion": "^4.0.487",
    "resend": "6.18.0",
    "sharp": "0.35.0",
    "stripe": "^22.3.0",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fast-uri": "3.1.5",
    "postcss": "^8.5.10",
    "sharp": "0.35.0"
  }
}
