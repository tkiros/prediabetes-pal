# Prediabetes Pal environment variables (names only — never commit real values).
# All are SERVER-ONLY. Never prefix any of these with NEXT_PUBLIC_.
# Set in Vercel → Settings → Environment Variables for Production + Preview only.

# --- Required for live model calls ---
OPENAI_API_KEY=

# --- Launch controls / kill-switch (Edge Config) ---
EDGE_CONFIG=

# --- PostgreSQL runtime (Vercel) ---
# Restricted DML-only application role; never use the Neon owner credential.
DATABASE_URL=
# Per-instance pool cap, integer 1..10. Default 3.
DATABASE_POOL_MAX=3

# --- PostgreSQL operator CLI only (never set in Vercel runtime) ---
# Neon owner/migrator credential. Production migration commands also require
# PAL_DB_ENV=production and reject the same username as DATABASE_URL.
DATABASE_MIGRATION_URL=
PAL_DB_ENV=

# --- Inbound abuse + cost controls (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global daily check cap (soft gate under the OpenAI dashboard hard cap). Default 2000.
PAL_DAILY_CHECK_CAP=

# --- Optional model tuning ---
# Override the model id (default: gpt-5.4-mini).
PAL_MODEL=
# Reasoning effort lever. Leave blank for behavior-neutral default; only set
# (e.g. "low") AFTER confirming zero-harmful-SAFE with `npm run eval:pal`.
PAL_REASONING_EFFORT=
# OpenAI-compatible endpoint. Production allows ONLY the OpenRouter host
# (https://openrouter.ai/api/v1); other compatible hosts are preview/eval-only.
# Set together with provider-prefixed PAL_MODEL / PAL_VISION_MODEL
# (e.g. openai/gpt-5.4-mini); unset it (and drop the prefixes) to fall back to
# direct OpenAI — the no-redeploy rollback path.
OPENAI_BASE_URL=

# --- Retention features (server twin gates the client twin; see docs/ops/env-reference.md) ---
# Rollout order: MEAL_MEMORY_ENABLED → NEXT_PUBLIC_MEAL_MEMORY (rebuild) →
# LEARNING_JOURNEY_ENABLED → NEXT_PUBLIC_LEARNING_JOURNEY (rebuild).
# Rollback = unset the server twin (runtime kill switch, no rebuild).
MEAL_MEMORY_ENABLED=
NEXT_PUBLIC_MEAL_MEMORY=
LEARNING_JOURNEY_ENABLED=
NEXT_PUBLIC_LEARNING_JOURNEY=

# --- Non-production test seams (DO NOT set in production) ---
# Force the pause gate without touching live Edge Config (ignored in production).
PAL_LAUNCH_MODE_OVERRIDE=
# Set to 1 to route the eval suite at the live OpenAI model (costs money).
PAL_LIVE_EVAL=
# Set to 1 to arm live meal-photo eval spend (the npm script supplies it).
EVAL_MEAL_PHOTO_LIVE=
# Set to 1 to stub the Stripe-resolved Pantry price in dev/test (never production).
PANTRY_PRICE_STUB=

# --- Transactional email (magic links + pantry intake/report emails) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Upstash management API (CLI only; the app uses the REST URL/TOKEN above) ---
UPSTASH_API_KEY=

# --- Pantry Review one-time product (price behind the Payment Link) ---
STRIPE_PRICE_PANTRY=

# Google Play purchases are OFF by default. Only exact 1 enables Digital Goods
# purchase UI and new Play receipt verification in a reviewed production build.
NEXT_PUBLIC_PLAY_BILLING=

# Dedicated private Vercel Blob store for Pantry photos. Do not reuse the
# legacy public-store BLOB_READ_WRITE_TOKEN; Blob access mode is immutable.
PANTRY_BLOB_READ_WRITE_TOKEN=

# Vision model for pantry photo EXTRACTION only (never judging). Default: gpt-5.4-mini.
PAL_VISION_MODEL=

# --- Founder ops ---
# founder-only /admin/pantry gate
ADMIN_EMAIL=
