# dependencies
node_modules/

# next.js build output
.next/
.next-e2e-*/
out/
# generated by `next dev`/`next build`/`next typegen` — the routes import
# flip-flops between .next/types and .next/dev/types, so it can't stay tracked
next-env.d.ts

# test artifacts
test-results/
playwright-report/
coverage/
artifacts/

# plaintext key files must never be committed (QA 2026-07-10 finding SEC-01)
openr.md

# generated marketing captures (Task 8.4 — regenerated on demand)
marketing/screenshots/
marketing/screencasts/
# rendered carousel slides. The SOURCES next to them (posts.json, template.html,
# README.md) are tracked on purpose — claims-boundary-copy.test.ts scans
# posts.json, so it has to exist in a clean checkout or CI fails on a missing file.
marketing/carousels/out/

# env
.env
.env.*
!.env.example

# Vercel CLI env dumps (N-21). `vercel env pull`-style output is an env file
# wearing a .txt name, so it slipped straight past the .env* rules above and got
# committed (213ab8a). It carried a live VERCEL_OIDC_TOKEN — see
# docs/qa/05-known-risks-and-blockers.md N-21. Match on content-shape, not one
# filename, so the next dump doesn't find a new hole.
prod-env-check.txt
*env-check.txt
*env-dump.txt
vercel-env*.txt

# misc
.DS_Store
*.tsbuildinfo
.vercel
.env*

# video-engine rendered assets (large binaries; regenerate from specs)
video-engine/output/**/assets/
.gstack/
