exports[`Home with the orient door shut stays byte-for-byte (Task 3.5) > guest Home before hydration, flag "" 1`] = `"<div data-testid="dashboard"><div class="dash-greet"><h1 class="dash-greet-date">Tuesday, September 15</h1><p class="dash-greet-sum" data-testid="dash-summary">No meals checked yet.</p></div><section class="meal-hero" aria-labelledby="meal-hero-title"><p class="meal-hero-eyebrow">Meal check</p><h2 id="meal-hero-title">What are you eating?</h2><p class="meal-hero-copy">Type it or say it. Get one clear food signal.</p><form class="meal-hero-form"><label class="sr-only" for="hero-meal">Meal to check</label><input id="hero-meal" class="meal-hero-input" placeholder="Example: oatmeal with walnuts" autoComplete="off" enterKeyHint="go" name="meal" value=""/><button type="submit" class="meal-hero-button" data-testid="dash-check-cta">Check meal<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16"></path><path d="M13 5l7 7-7 7"></path></svg></button></form></section><p class="dash-next-action" data-testid="next-action"><a href="/check">Check your next uncertain meal.</a></p><section class="dash-card" aria-label="Today"><h3 class="dash-sect-title">Today</h3><p class="dash-preview-note" data-testid="dash-day0-note">Your checks will appear here — today stays quiet until you check a meal, never marked against you.</p></section></div>"`;

