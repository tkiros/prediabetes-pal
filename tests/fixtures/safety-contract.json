{
  "forbiddenClaims": [
    {
      "label": "diagnosis",
      "pattern": "\\bdiagnos(e|es|ing|is)\\b",
      "example": "Prediabetes Pal diagnoses whether you have prediabetes."
    },
    {
      "label": "treatment",
      "pattern": "\\btreat(s|ed|ing)?\\b",
      "example": "Prediabetes Pal treats prediabetes through meal advice."
    },
    {
      "label": "prevention",
      "pattern": "\\bprevent(s|ed|ing|ion)?\\b",
      "example": "This meal plan prevents diabetes."
    },
    {
      "label": "cure",
      "pattern": "\\bcure(s|d|ing)?\\b",
      "example": "Prediabetes Pal cures prediabetes."
    },
    {
      "label": "reversal",
      "pattern": "\\brevers(e|es|ing|al)\\b",
      "example": "Prediabetes Pal helps reverse prediabetes."
    },
    {
      "label": "fda approval",
      "pattern": "\\bFDA\\b.{0,25}\\b(approved|approval|cleared|clearance)\\b",
      "example": "FDA approved guidance for prediabetes."
    },
    {
      "label": "unsupported clinical proof",
      "pattern": "\\b(clinically proven|clinically validated|doctor recommended)\\b",
      "example": "Clinically proven to lower your A1C."
    }
  ],
  "forbiddenPredictions": [
    {
      "label": "future a1c",
      "pattern": "\\bA1C\\b.{0,40}\\b(will|going to|drop to|fall to|rise to)\\b",
      "example": "Your A1C will drop to 5.8% if you keep eating this way."
    },
    {
      "label": "glucose curve",
      "pattern": "\\bglucose\\b.{0,40}\\bcurve\\b",
      "example": "This meal predicts your glucose curve for the next two hours."
    },
    {
      "label": "exact glucose spike",
      "pattern": "\\bspike(?:s|d)?\\b.{0,20}\\b\\d+(?:\\.\\d+)?\\s*mg\\/dL\\b",
      "example": "This meal will spike your glucose by 32 mg/dL."
    },
    {
      "label": "exact gi",
      "pattern": "\\bGI\\s*(?:of|=)?\\s*\\d+\\b",
      "example": "This meal has a GI of 68."
    },
    {
      "label": "exact gl",
      "pattern": "\\bGL\\s*(?:of|=)?\\s*\\d+\\b",
      "example": "This meal has a GL of 22."
    }
  ],
  "a1cRoutes": {
    "requiredRouteIds": [
      "below_prediabetes_range",
      "prediabetes_57_59",
      "prediabetes_60_62",
      "prediabetes_63_64",
      "diabetes_range_out_of_scope"
    ]
  },
  "qualitativeOnly": {
    "forbiddenPatterns": [
      {
        "label": "exact mg/dL",
        "pattern": "\\b\\d+(?:\\.\\d+)?\\s*mg\\/dL\\b"
      },
      {
        "label": "exact gi",
        "pattern": "\\bGI\\s*(?:of|=)?\\s*\\d+\\b"
      },
      {
        "label": "exact gl",
        "pattern": "\\bGL\\s*(?:of|=)?\\s*\\d+\\b"
      },
      {
        "label": "exact spike phrasing",
        "pattern": "\\bspike(?:s|d)?\\b.{0,20}\\b\\d+(?:\\.\\d+)?\\s*mg\\/dL\\b"
      },
      {
        "label": "exact carb grams",
        "pattern": "\\b\\d+(?:\\.\\d+)?\\s*(?:grams?|g)\\b"
      },
      {
        "label": "timed recheck instruction",
        "pattern": "\\b(?:recheck|check\\s+again|retest|test\\s+again|wait)\\b[^.?!]{0,40}\\b\\d+\\s*min|\\b(?:in|within|after|every)\\s+\\d+\\s*minutes?\\b"
      },
      {
        "label": "first-aid treatment instruction",
        "pattern": "\\bfast[-\\s]acting\\s+carb|\\bglucose\\s+tablets?\\b|\\bfirst[-\\s]aid\\b"
      },
      {
        "label": "personal safety assurance",
        "pattern": "\\bsafe\\s+for\\s+you\\b|\\bwon'?t\\s+spike\\s+you\\b|\\bnot\\s+spike\\s+you\\b|\\bsafe\\s+for\\s+your\\s+(?:body|levels?|range)\\b"
      },
      {
        "label": "personal suitability",
        "pattern": "\\bfits?\\s+your\\s+range\\b|\\bwork(?:s)?\\s+better\\s+for\\s+you\\b|\\bright\\s+for\\s+your\\s+(?:range|levels?|body)\\b"
      },
      {
        "label": "individual outcome prediction",
        "pattern": "\\bbring(?:s|ing)?\\b[^.?!]{0,30}\\blevels?\\s+down\\b|\\blower(?:s|ing)?\\s+your\\s+(?:levels?|blood\\s+sugar|glucose|a1c)\\b|\\bkeep(?:s)?\\s+your\\s+(?:blood\\s+sugar|glucose|levels?)\\s+(?:stable|steady|low|down)\\b"
      }
    ]
  },
  "uncertaintyFloors": [
    {
      "scenarioId": "non_food_input",
      "minimumClassification": "None"
    },
    {
      "scenarioId": "ambiguous_food",
      "minimumClassification": "MODERATE"
    },
    {
      "scenarioId": "carbs_only_meal",
      "minimumClassification": "MODERATE"
    },
    {
      "scenarioId": "upper_band_borderline",
      "minimumClassification": "MODERATE"
    },
    {
      "scenarioId": "sugary_drink_or_dessert",
      "minimumClassification": "HIGH"
    }
  ]
}
